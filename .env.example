# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string. The docker-compose.yml in this repo spins up
# a matching local instance — see README.md.
DATABASE_URL="postgresql://quicktodo:quicktodo@localhost:5432/quicktodo?schema=public"

# HTTP port the API listens on.
PORT=4000

# Secret used to sign JWTs. Generate a real one for anything beyond local
# dev, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="dev-only-change-me"

# Access token lifetime (any value accepted by the `ms` package / jsonwebtoken,
# e.g. "15m", "1h", "7d"). No refresh tokens in v1 — see docs/DATABASE_DESIGN.md.
JWT_EXPIRES_IN="7d"

# Origin(s) allowed to call this API from the browser, comma-separated.
# Vite's default dev server:
CORS_ORIGIN="http://localhost:5173"
